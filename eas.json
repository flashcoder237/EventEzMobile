{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://eventez.online/api",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "415546287335-63oodhp17e0hc4vl2j0j0fh4j1fs283t.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "415546287335-t02gkoirers5enime8dc0vc7nl4ps25e.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "415546287335-2uievbv8gauor5utligkrlvb1cm0tb1q.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://eventez.online/api",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "415546287335-63oodhp17e0hc4vl2j0j0fh4j1fs283t.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "415546287335-t02gkoirers5enime8dc0vc7nl4ps25e.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "415546287335-2uievbv8gauor5utligkrlvb1cm0tb1q.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
