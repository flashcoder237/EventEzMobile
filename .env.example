# EventEz Mobile - Variables d'environnement
#
# Copier ce fichier en `.env` et remplir les valeurs. Pour le BUILD EAS, ce sont
# les blocs `env` de eas.json (par profil) qui font foi — le `.env` sert au dev
# local (`expo start`). Garder les deux cohérents.

# ═══════════════════════════════════════════════════════════════════════════
# REQUISES
# ═══════════════════════════════════════════════════════════════════════════

# URL de l'API Backend.
# Dev sur appareil physique : utiliser l'IP locale de la machine.
#   Ex: http://192.168.1.100:8000/api
# Prod : https://eventez.online/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Google OAuth (console.cloud.google.com — projet eventez-489122).
# iOS + Web client IDs lus par GoogleSignin.configure() dans App.tsx.
# iOS URL scheme consommé par le plugin @react-native-google-signin (app.config.js).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Cle Google Maps (REQUISE pour afficher la carte).
# Restreindre a net.overbrand.eventez + SHA-1 du keystore.
# JAMAIS committer. EAS : `eas secret:create --name GOOGLE_MAPS_API_KEY --value <key>`.
# Les deux noms sont attendus (natif Android + lecture JS).
GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# URL des traductions distantes (i18n).
EXPO_PUBLIC_TRANSLATIONS_URL=https://flashcoder237.github.io/eventez-i18n

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONNELLES (toutes ont un fallback sûr — l'app build sans elles)
# ═══════════════════════════════════════════════════════════════════════════

# Sentry — crash reporting & remontée d'erreurs.
# Si vide, Sentry n'est pas initialisé (no-op) — pratique en dev local.
# Prod : créer un projet "react-native" sur sentry.io et coller le DSN.
# Voir src/services/crashReporting.ts (initCrashReporting, captureException…).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXX.ingest.sentry.io/XXXXXX

# Environnement Sentry (fallback: 'production' en build, 'development' en dev).
# EXPO_PUBLIC_ENV=production

# URL du site web (fallback: https://eventez.online). Cf. src/constants/urls.ts.
# EXPO_PUBLIC_WEB_URL=https://eventez.online

# Devise de repli pour le payeur international (fallback codé en dur).
# Code ISO 3 lettres majuscules. Cf. src/constants/currency.ts.
# EXPO_PUBLIC_FALLBACK_CURRENCY=EUR

# ═══════════════════════════════════════════════════════════════════════════
# BUILD iOS (facultatif, seulement pour surcharger)
# ═══════════════════════════════════════════════════════════════════════════
# Apple Team ID pour signer la Notification Service Extension. Par défaut
# 9T6HK8G8B5 (codé dans plugins/withNotificationServiceExtension.js).
# EXPO_APPLE_TEAM_ID=9T6HK8G8B5
