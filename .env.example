# EventEz Mobile - Variables d'environnement

# URL de l'API Backend
# Utiliser l'IP locale de la machine pour les tests sur appareil physique
# Ex: http://192.168.1.100:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Cle Google Maps Android (REQUISE pour afficher la carte)
# Doit etre restreinte a com.eventez.mobile + SHA-1 de votre keystore.
# JAMAIS committer cette cle. Pour EAS Build : `eas secret:create --name GOOGLE_MAPS_API_KEY --value <key>`
GOOGLE_MAPS_API_KEY=

# Sentry — crash reporting & remontée d'erreurs serveur
# Si vide, Sentry n'est pas initialisé (no-op) — pratique en dev local.
# En prod : créer un projet "react-native" sur sentry.io et coller le DSN.
# Voir src/services/crashReporting.ts pour les helpers (initCrashReporting,
# captureException, captureMessage).
# EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXX.ingest.sentry.io/XXXXXX
