# EventEz Mobile - Variables d'environnement

# URL de l'API Backend
# Dev local : 
# EXPO_PUBLIC_API_URL = http://192.168.225.55:8000/api
# Production : https://eventez.online/api
EXPO_PUBLIC_API_URL=https://eventez.online/api

# Clés API (optionnel)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Google OAuth (obtenir sur https://console.cloud.google.com)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
