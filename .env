# Ex: http://192.168.1.100:8000/api
# EXPO_PUBLIC_API_URL=http://192.168.87.55:8000/api
EXPO_PUBLIC_API_URL=https://92d4-129-0-76-45.ngrok-free.app/api

# Clés API (optionnel)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Google OAuth (obtenir sur https://console.cloud.google.com)
