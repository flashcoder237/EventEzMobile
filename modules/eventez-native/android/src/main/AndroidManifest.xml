<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- G10 : verrou « écran éteint contre l'oreille » (permission normale, sans dialogue). -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!-- X3 : widget « Prochain billet ». Fusionné dans le manifeste de l'app. -->
    <receiver
      android:name="net.overbrand.eventez.nativebridge.NextTicketWidgetProvider"
      android:exported="true"
      android:label="@string/eventez_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/eventez_next_ticket_widget_info" />
    </receiver>

    <!-- X11 : tuile Réglages rapides « Mon prochain billet ». -->
    <service
      android:name="net.overbrand.eventez.nativebridge.NextTicketTileService"
      android:exported="true"
      android:icon="@drawable/eventez_ic_ticket"
      android:label="@string/eventez_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
      <meta-data
        android:name="android.service.quicksettings.ACTIVE_TILE"
        android:value="false" />
    </service>
  </application>
</manifest>
