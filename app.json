{
  "expo": {
    "name": "EventEz",
    "slug": "EventEzMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "automatic",
    "scheme": "eventez",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.overbrand.eventez",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:eventez.online"
      ],
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "net.overbrand.eventez",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/events/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/organizers/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/speakers/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/payment-success/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/payment-failed/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/verify-email/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/reset-password/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/transfer/"
            },
            {
              "scheme": "https",
              "host": "eventez.online",
              "pathPrefix": "/team-invitation/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.163496687935-9nv0q3dgrktseukr4meoomb8rk5lqd6g"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permet à EventEz d'accéder à votre position pour trouver des événements à proximité."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permet à EventEz d'utiliser la caméra pour scanner les QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ],
      "./plugins/withNetworkSecurity",
      "./plugins/withRemoveProblematicPermissions",
      "./plugins/withNotificationServiceExtension",
      "./plugins/withNotifeeMavenRepo",
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "38c6e07f-08bf-4c69-aa59-1012913e01a2"
      }
    },
    "owner": "cedric_tefoye"
  }
}
